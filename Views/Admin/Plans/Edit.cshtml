@model GymMvc.Models.Plan

@{
    ViewData["Title"] = "Edit Plan";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Edit plan",
    ["Description"] = "Update the membership plan details.",
    ["Eyebrow"] = "Operations / Plans"
})

<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel">

            <form asp-controller="Admin"
                  asp-action="PlansEdit"
                  asp-route-id="@Model.Id"
                  method="post"
                  id="editPlanForm">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="DurationMonths"
                               class="form-label">
                        </label>

                        <input asp-for="DurationMonths"
                               class="form-control"
                               type="number"
                               min="1"
                               max="60" />

                        <span asp-validation-for="DurationMonths"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Price"
                               class="form-label">
                        </label>

                        <input asp-for="Price"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="d-flex justify-content-end
                            flex-wrap
                            gap-2
                            mt-4">

                    <a asp-controller="Admin"
                       asp-action="PlansDetails"
                       asp-route-id="@Model.Id"
                       class="btn btn-iron-outline">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-iron"
                            id="editPlanButton">

                        <span id="editPlanText">
                            Save changes
                        </span>

                        <span id="editPlanLoading"
                              class="d-none">

                            <span class="spinner-border spinner-border-sm me-2"
                                  aria-hidden="true"></span>

                            Saving...

                        </span>

                    </button>

                </div>

            </form>

        </section>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("editPlanForm");

            const button =
                document.getElementById("editPlanButton");

            const text =
                document.getElementById("editPlanText");

            const loading =
                document.getElementById("editPlanLoading");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function () {

                if (!form.checkValidity()) {
                    return;
                }

                button.disabled = true;

                text?.classList.add("d-none");
                loading?.classList.remove("d-none");
            });

        });
    </script>
}