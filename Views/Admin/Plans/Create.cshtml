@model GymMvc.Models.Plan

@{
    ViewData["Title"] = "Create Plan";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Create plan",
    ["Description"] = "Add a new membership option to the catalogue.",
    ["Eyebrow"] = "Operations / Plans"
})

<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel">

            <form asp-controller="Admin"
                  asp-action="PlansCreate"
                  method="post"
                  id="createPlanForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               autocomplete="off"
                               placeholder="e.g. Performance" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="DurationMonths"
                               class="form-label">
                        </label>

                        <input asp-for="DurationMonths"
                               class="form-control"
                               type="number"
                               min="1"
                               max="60" />

                        <span asp-validation-for="DurationMonths"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Price"
                               class="form-label">
                        </label>

                        <input asp-for="Price"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0" />

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="d-flex justify-content-end
                            flex-wrap
                            gap-2
                            mt-4">

                    <a asp-controller="Admin"
                       asp-action="Plans"
                       class="btn btn-iron-outline">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-iron"
                            id="createPlanButton">

                        <span id="createPlanText">
                            Create plan
                        </span>

                        <span id="createPlanLoading"
                              class="d-none">

                            <span class="spinner-border spinner-border-sm me-2"
                                  aria-hidden="true"></span>

                            Creating...

                        </span>

                    </button>

                </div>

            </form>

        </section>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("createPlanForm");

            const button =
                document.getElementById("createPlanButton");

            const text =
                document.getElementById("createPlanText");

            const loading =
                document.getElementById("createPlanLoading");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function () {

                if (!form.checkValidity()) {
                    return;
                }

                button.disabled = true;

                text?.classList.add("d-none");
                loading?.classList.remove("d-none");
            });

        });
    </script>
}