@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Dashboard"] = true;

    var activeMembers = ViewBag.ActiveMembers ?? 0;
    var monthlyIncome = ViewBag.MonthlyIncome ?? 0m;
    var expiringSoon = ViewBag.ExpiringSoon ?? 0;
    var classesCount = ViewBag.ClassesCount ?? 0;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Admin dashboard",
    ["Description"] = "A quick operational view of the gym, memberships, and floor activity.",
    ["Eyebrow"] = "IRONCORE / Operations"
})

<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-3">
        @await Html.PartialAsync("_StatCard",
            new Dictionary<string, string>
            {
                ["Title"] = "Active members",
                ["Value"] = activeMembers.ToString(),
                ["Icon"] = "01"
            })
    </div>

    <div class="col-sm-6 col-xl-3">
        @await Html.PartialAsync("_StatCard",
            new Dictionary<string, string>
            {
                ["Title"] = "Monthly income",
                ["Value"] = monthlyIncome.ToString("N0"),
                ["Icon"] = "02"
            })
    </div>

    <div class="col-sm-6 col-xl-3">
        @await Html.PartialAsync("_StatCard",
            new Dictionary<string, string>
            {
                ["Title"] = "Expiring this week",
                ["Value"] = expiringSoon.ToString(),
                ["Icon"] = "03"
            })
    </div>

    <div class="col-sm-6 col-xl-3">
        @await Html.PartialAsync("_StatCard",
            new Dictionary<string, string>
            {
                ["Title"] = "Classes",
                ["Value"] = classesCount.ToString(),
                ["Icon"] = "04"
            })
    </div>

</div>


<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel h-100">

            <div class="d-flex justify-content-between
                        align-items-start
                        gap-3 mb-4">

                <div>

                    <p class="section-kicker mb-1">
                        Operations
                    </p>

                    <h2 class="panel-title mb-1">
                        Keep the floor moving.
                    </h2>

                    <p class="text-secondary mb-0">
                        Use the admin workspace to manage
                        memberships, classes, trainers,
                        payments, and members.
                    </p>

                </div>

                <span class="status-pill">
                    Systems operational
                </span>

            </div>


            <div class="row g-3">

                <div class="col-md-6">

                    <a asp-controller="Admin"
                       asp-action="Members"
                       class="text-decoration-none">

                        <div class="metric-block h-100">

                            <span class="text-secondary">
                                Member management
                            </span>

                            <strong class="d-block mt-2">
                                Members
                            </strong>

                            <small class="text-secondary d-block mt-2">
                                Profiles, fitness information,
                                progress, and records.
                            </small>

                        </div>

                    </a>

                </div>


                <div class="col-md-6">

                    <a asp-controller="Admin"
                       asp-action="Plans"
                       class="text-decoration-none">

                        <div class="metric-block h-100">

                            <span class="text-secondary">
                                Membership catalogue
                            </span>

                            <strong class="d-block mt-2">
                                Plans
                            </strong>

                            <small class="text-secondary d-block mt-2">
                                Pricing, duration, and membership
                                options.
                            </small>

                        </div>

                    </a>

                </div>


                <div class="col-md-6">

                    <a asp-controller="Admin"
                       asp-action="Classes"
                       class="text-decoration-none">

                        <div class="metric-block h-100">

                            <span class="text-secondary">
                                Weekly schedule
                            </span>

                            <strong class="d-block mt-2">
                                Classes
                            </strong>

                            <small class="text-secondary d-block mt-2">
                                Trainers, timing, capacity,
                                and bookings.
                            </small>

                        </div>

                    </a>

                </div>


                <div class="col-md-6">

                    <a asp-controller="Admin"
                       asp-action="Reports"
                       class="text-decoration-none">

                        <div class="metric-block h-100">

                            <span class="text-secondary">
                                Business overview
                            </span>

                            <strong class="d-block mt-2">
                                Reports
                            </strong>

                            <small class="text-secondary d-block mt-2">
                                Income, active members,
                                expiring memberships,
                                and popular classes.
                            </small>

                        </div>

                    </a>

                </div>

            </div>

        </section>

    </div>


    <div class="col-lg-4">

        <section class="content-panel h-100">

            <p class="section-kicker">
                Quick actions
            </p>

            <h2 class="panel-title mb-4">
                Work from here.
            </h2>


            <div class="d-grid gap-2">

                <a asp-controller="Admin"
                   asp-action="MembersCreate"
                   class="btn btn-iron">

                    Add member

                </a>


                <a asp-controller="Admin"
                   asp-action="PlansCreate"
                   class="btn btn-iron-outline">

                    Create plan

                </a>


                <a asp-controller="Admin"
                   asp-action="ClassesCreate"
                   class="btn btn-iron-outline">

                    Add class

                </a>


                <a asp-controller="Admin"
                   asp-action="Trainers"
                   class="btn btn-iron-outline">

                    Manage trainers

                </a>

            </div>

        </section>

    </div>

</div>