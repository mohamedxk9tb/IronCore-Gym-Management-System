@model GymMvc.ViewModels.TrainerFormViewModel

@{
    ViewData["Title"] = "Add Trainer";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Add trainer",
    ["Description"] = "Create a new trainer profile for the IRONCORE team.",
    ["Eyebrow"] = "Operations / Trainers"
})

<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel">

            <form asp-controller="AdminTrainers"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label">
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               placeholder="Trainer full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Specialty"
                               class="form-label">
                        </label>

                        <input asp-for="Specialty"
                               class="form-control"
                               placeholder="e.g. Strength & Conditioning" />

                        <span asp-validation-for="Specialty"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Certificates"
                               class="form-label">
                        </label>

                        <textarea asp-for="Certificates"
                                  class="form-control"
                                  rows="4"
                                  placeholder="List relevant certifications"></textarea>

                        <span asp-validation-for="Certificates"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="d-flex justify-content-end
                            flex-wrap
                            gap-2
                            mt-4">

                    <a asp-controller="AdminTrainers"
                       asp-action="Index"
                       class="btn btn-iron-outline">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-iron"
                            data-submit-loading>

                        <span data-submit-text>
                            Create trainer
                        </span>

                        <span class="d-none"
                              data-submit-spinner>
                            <span class="spinner-border spinner-border-sm me-2"
                                  aria-hidden="true"></span>
                            Creating...
                        </span>

                    </button>

                </div>

            </form>

        </section>

    </div>

    <div class="col-lg-4">

        <section class="content-panel h-100">

            <p class="auth-kicker">
                TRAINER PROFILE
            </p>

            <h3 class="mb-3">
                Build the coaching team.
            </h3>

            <p class="text-secondary mb-0">
                Add the trainer's core profile information.
                Additional trainer activity is managed through
                the trainer dashboard and class system.
            </p>

        </section>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.querySelector("form");

            if (!form) {
                return;
            }

            form.addEventListener("submit", function () {

                if (!form.checkValidity()) {
                    return;
                }

                const button =
                    form.querySelector("[data-submit-loading]");

                if (!button) {
                    return;
                }

                const text =
                    button.querySelector("[data-submit-text]");

                const spinner =
                    button.querySelector("[data-submit-spinner]");

                button.disabled = true;

                if (text) {
                    text.classList.add("d-none");
                }

                if (spinner) {
                    spinner.classList.remove("d-none");
                }
            });
        });
    </script>
}