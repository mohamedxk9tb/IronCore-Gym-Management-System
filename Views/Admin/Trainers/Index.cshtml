@model IEnumerable<GymMvc.Models.Trainer>

@{
    ViewData["Title"] = "Trainers";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Trainers",
    ["Description"] = "Manage trainer profiles, specialties, and certifications.",
    ["Eyebrow"] = "Operations"
})

<section class="content-panel">

    <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-center
                gap-3 mb-4">

        <div>
            <p class="section-kicker mb-1">
                Team management
            </p>

            <h2 class="panel-title mb-1">
                Trainers
            </h2>

            <p class="text-secondary mb-0">
                Manage the coaches available across the facility.
            </p>
        </div>

        <a asp-controller="AdminTrainers"
           asp-action="Create"
           class="btn btn-iron">
            Add trainer
        </a>

    </div>


    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-dark table-hover align-middle mb-0">

                <thead>
                    <tr>

                        <th scope="col">
                            Trainer
                        </th>

                        <th scope="col">
                            Specialty
                        </th>

                        <th scope="col">
                            Certificates
                        </th>

                        <th scope="col"
                            class="text-end">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var trainer in Model)
                    {
                        <tr>

                            <td>
                                <div class="fw-semibold">
                                    @trainer.FullName
                                </div>
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @trainer.Specialty
                                </span>
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @(
                                        string.IsNullOrWhiteSpace(trainer.Certificates)
                                            ? "—"
                                            : trainer.Certificates
                                    )
                                </span>
                            </td>

                            <td class="text-end">

                                <div class="d-inline-flex
                                            flex-wrap
                                            justify-content-end
                                            gap-2">

                                    <a asp-controller="AdminTrainers"
                                       asp-action="Details"
                                       asp-route-id="@trainer.Id"
                                       class="btn btn-sm btn-iron-outline">
                                        View
                                    </a>

                                    <a asp-controller="AdminTrainers"
                                       asp-action="Edit"
                                       asp-route-id="@trainer.Id"
                                       class="btn btn-sm btn-iron-outline">
                                        Edit
                                    </a>

                                    <a asp-controller="AdminTrainers"
                                       asp-action="Delete"
                                       asp-route-id="@trainer.Id"
                                       class="btn btn-sm btn-iron-outline">
                                        Delete
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        @await Html.PartialAsync(
            "_EmptyState",
            new Dictionary<string, string>
            {
                ["Title"] = "No trainers found",
                ["Message"] = "There are no trainers in the system yet.",
                ["ActionText"] = "Add trainer",
                ["ActionController"] = "AdminTrainers",
                ["Action"] = "Create"
            })
    }

</section>