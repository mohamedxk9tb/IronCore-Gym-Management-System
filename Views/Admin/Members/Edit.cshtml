@model GymMvc.Models.Member

@{
    ViewData["Title"] = "Edit Member";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Edit member",
    ["Description"] = "Update the member's personal and fitness information.",
    ["Eyebrow"] = "Operations / Members"
})

<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel">

            <form asp-controller="Admin"
                  asp-action="MembersEdit"
                  asp-route-id="@Model.Id"
                  method="post"
                  id="editMemberForm">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label">
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Height"
                               class="form-label">
                        </label>

                        <input asp-for="Height"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="300" />

                        <span asp-validation-for="Height"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Weight"
                               class="form-label">
                        </label>

                        <input asp-for="Weight"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="500" />

                        <span asp-validation-for="Weight"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="FitnessLevel"
                               class="form-label">
                        </label>

                        <select asp-for="FitnessLevel"
                                class="form-select">

                            <option value="">
                                Select fitness level
                            </option>

                            <option value="Beginner">
                                Beginner
                            </option>

                            <option value="Intermediate">
                                Intermediate
                            </option>

                            <option value="Advanced">
                                Advanced
                            </option>

                        </select>

                        <span asp-validation-for="FitnessLevel"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12">

                        <label asp-for="Goal"
                               class="form-label">
                        </label>

                        <textarea asp-for="Goal"
                                  class="form-control"
                                  rows="4"
                                  maxlength="250"></textarea>

                        <span asp-validation-for="Goal"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="d-flex justify-content-end
                            flex-wrap
                            gap-2
                            mt-4">

                    <a asp-controller="Admin"
                       asp-action="MembersDetails"
                       asp-route-id="@Model.Id"
                       class="btn btn-iron-outline">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-iron"
                            id="editMemberButton">

                        <span id="editMemberText">
                            Save changes
                        </span>

                        <span id="editMemberLoading"
                              class="d-none">

                            <span class="spinner-border spinner-border-sm me-2"
                                  aria-hidden="true"></span>

                            Saving...

                        </span>

                    </button>

                </div>

            </form>

        </section>

    </div>


    <div class="col-lg-4">

        <section class="content-panel h-100">

            <p class="auth-kicker">
                MEMBER #@Model.Id
            </p>

            <h3 class="mb-3">
                Keep the record current.
            </h3>

            <p class="text-secondary mb-0">
                Changes here update the member's main profile
                record. Weight history and check-in history
                remain available separately.
            </p>

        </section>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("editMemberForm");

            const button =
                document.getElementById("editMemberButton");

            const text =
                document.getElementById("editMemberText");

            const loading =
                document.getElementById("editMemberLoading");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function () {

                if (!form.checkValidity()) {
                    return;
                }

                button.disabled = true;

                if (text) {
                    text.classList.add("d-none");
                }

                if (loading) {
                    loading.classList.remove("d-none");
                }
            });

        });
    </script>
}