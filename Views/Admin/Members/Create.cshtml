@model GymMvc.Models.Member

@{
    ViewData["Title"] = "Add Member";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Add member",
    ["Description"] = "Create a new member profile and fitness record.",
    ["Eyebrow"] = "Operations / Members"
})

<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel">

            <form asp-controller="Admin"
                  asp-action="MembersCreate"
                  method="post"
                  id="createMemberForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label">
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               placeholder="Member full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               placeholder="member@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Height"
                               class="form-label">
                        </label>

                        <input asp-for="Height"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="300"
                               placeholder="cm" />

                        <span asp-validation-for="Height"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Weight"
                               class="form-label">
                        </label>

                        <input asp-for="Weight"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="500"
                               placeholder="kg" />

                        <span asp-validation-for="Weight"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="FitnessLevel"
                               class="form-label">
                        </label>

                        <select asp-for="FitnessLevel"
                                class="form-select">

                            <option value="">
                                Select fitness level
                            </option>

                            <option value="Beginner">
                                Beginner
                            </option>

                            <option value="Intermediate">
                                Intermediate
                            </option>

                            <option value="Advanced">
                                Advanced
                            </option>

                        </select>

                        <span asp-validation-for="FitnessLevel"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12">

                        <label asp-for="Goal"
                               class="form-label">
                        </label>

                        <textarea asp-for="Goal"
                                  class="form-control"
                                  rows="4"
                                  maxlength="250"
                                  placeholder="Member's primary fitness goal"></textarea>

                        <span asp-validation-for="Goal"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="d-flex justify-content-end
                            flex-wrap
                            gap-2
                            mt-4">

                    <a asp-controller="Admin"
                       asp-action="Members"
                       class="btn btn-iron-outline">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-iron"
                            id="createMemberButton">

                        <span id="createMemberText">
                            Create member
                        </span>

                        <span id="createMemberLoading"
                              class="d-none">

                            <span class="spinner-border spinner-border-sm me-2"
                                  aria-hidden="true"></span>

                            Creating...

                        </span>

                    </button>

                </div>

            </form>

        </section>

    </div>


    <div class="col-lg-4">

        <section class="content-panel h-100">

            <p class="auth-kicker">
                NEW MEMBER
            </p>

            <h3 class="mb-3">
                Build the record once.
            </h3>

            <p class="text-secondary mb-0">
                Add the member's core personal and fitness
                information. Progress history and facility
                visits are recorded separately.
            </p>

        </section>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("createMemberForm");

            const button =
                document.getElementById("createMemberButton");

            const text =
                document.getElementById("createMemberText");

            const loading =
                document.getElementById("createMemberLoading");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function () {

                if (!form.checkValidity()) {
                    return;
                }

                button.disabled = true;

                if (text) {
                    text.classList.add("d-none");
                }

                if (loading) {
                    loading.classList.remove("d-none");
                }
            });

        });
    </script>
}