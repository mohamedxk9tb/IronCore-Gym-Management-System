@model GymMvc.Models.Member

@{
    ViewData["Title"] = "Add Member";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Add member",
    ["Description"] = "Create a new member profile.",
    ["Eyebrow"] = "Admin / Members"
})

<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel">

            <form asp-controller="Admin"
                  asp-action="MembersCreate"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label">
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               placeholder="e.g. Ahmed Hassan" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               placeholder="member@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Height"
                               class="form-label">
                        </label>

                        <input asp-for="Height"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="300"
                               placeholder="175" />

                        <span asp-validation-for="Height"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Weight"
                               class="form-label">
                        </label>

                        <input asp-for="Weight"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="500"
                               placeholder="80" />

                        <span asp-validation-for="Weight"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Goal"
                               class="form-label">
                        </label>

                        <textarea asp-for="Goal"
                                  class="form-control"
                                  rows="4"
                                  maxlength="250"
                                  placeholder="e.g. Build muscle and improve overall strength."></textarea>

                        <span asp-validation-for="Goal"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="d-flex justify-content-end
                            flex-wrap gap-2 mt-4">

                    <a asp-controller="Admin"
                       asp-action="Members"
                       class="btn btn-iron-outline">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-iron">
                        Create member
                    </button>

                </div>

            </form>

        </section>

    </div>

    <div class="col-lg-4">

        <section class="content-panel h-100">

            <p class="auth-kicker">
                IRONCORE / Member
            </p>

            <h3 class="mb-3">
                Build the record once.
            </h3>

            <p class="text-secondary mb-0">
                Keep the member profile accurate.
                Subscription and membership details
                will be connected when the membership
                module is integrated.
            </p>

        </section>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}