@{
    ViewData["Title"] = "Subscriptions"; ViewData["Dashboard"] = true;
}
<partial name="_PageHeader"
         model='new Dictionary<string, string> { ["Title"] = "Subscriptions", ["Description"] = "Static membership lifecycle and payment status.", ["Eyebrow"] = "Operations" }' />
<section class="content-panel">    <div class="admin-toolbar flex-wrap">
    <div class="d-flex flex-wrap gap-2"><select class="form-select" aria-label="Filter subscription state">
        <option>All subscriptions</option>
        <option>Active</option>
        <option>Expired</option>
        <option>Expiring soon</option>
    </select><select class="form-select" aria-label="Filter payment state">
    <option>All payment statuses</option>
    <option>Paid</option>
    <option>Pending</option>
</select></div><button class="btn btn-iron-outline btn-sm" type="button">Sort by end date</button>
</div>
<div class="table-responsive">
    <table class="table table-iron">
        <thead>
            <tr>
                <th>Member</th>
                <th>Plan</th>
                <th>Start date</th>
                <th>End date</th>
                <th>Status</th>
                <th>Payment</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Alex Morgan</td>
                <td>Performance</td>
                <td>04 Oct 2026</td>
                <td>04 Nov 2026</td>
                <td><span class="status-pill">Active</span></td>
                <td>Paid</td>
                <td><a class="text-link" asp-action="MembersDetails" asp-route-id="1">View</a></td>
            </tr>
            <tr>
                <td>Samira Khan</td>
                <td>Coached</td>
                <td>22 Sep 2026</td>
                <td>22 Sep 2027</td>
                <td><span class="status-pill">Active</span></td>
                <td>Paid</td>
                <td><a class="text-link" asp-action="MembersDetails" asp-route-id="2">View</a></td>
            </tr>
        </tbody>
    </table>
</div>
</section>