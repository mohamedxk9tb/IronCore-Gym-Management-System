@model GymMvc.ViewModels.TrainerDashboardViewModel

@{
    ViewData["Title"] = "Trainer Dashboard";
}

<div class="container py-4">

    <h1>Trainer Dashboard</h1>

    <p>
        Trainer:
        <strong>@Model.TrainerName</strong>
    </p>

    <hr />

    @foreach (var gymClass in Model.Classes)
    {
        <div class="card mb-4">

            <div class="card-body">

                <h3>@gymClass.ClassName</h3>

                <p>
                    Time:
                    <strong>@gymClass.Time</strong>
                </p>

                <h5>Members</h5>

                @foreach (var member in gymClass.Members)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <span>
                            @member.MemberName
                        </span>

                        @if (member.IsPresent)
                        {
                            <span class="badge bg-success">
                                Present
                            </span>
                        }
                        else
                        {
                            <form asp-action="MarkAttendance"
                                  method="post">

                                <input type="hidden"
                                       name="classId"
                                       value="@gymClass.Id" />

                                <input type="hidden"
                                       name="memberId"
                                       value="@member.MemberId" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Mark Present
                                </button>

                            </form>
                        }

                    </div>
                }

            </div>

        </div>
    }

</div>