@model GymMvc.ViewModels.PaymentCreateViewModel

@{
    ViewData["Title"] = "Complete Payment";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Complete payment",
    ["Description"] = "Review your payment before activating your membership.",
    ["Eyebrow"] = "Membership / Payment"
})

<section class="content-panel">

    <div class="row justify-content-center">
        <div class="col-12 col-xl-8">

            <div class="subscription-confirmation-card">

                <div class="subscription-card-header">

                    <div>
                        <p class="section-kicker mb-2">
                            Payment
                        </p>

                        <h2 class="panel-title mb-2">
                            @Model.PlanName
                        </h2>

                        <p class="text-secondary mb-0">
                            Complete your payment to activate your subscription.
                        </p>
                    </div>

                    <div class="subscription-price">

                        <span class="subscription-price-value">
                            @Model.PlanPrice.ToString("0.00")
                        </span>

                        <span class="subscription-price-currency">
                            EGP
                        </span>

                    </div>

                </div>

                <div class="subscription-details">

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            Plan
                        </span>

                        <strong>
                            @Model.PlanName
                        </strong>

                    </div>

                    <div class="subscription-detail">

                        <span class="subscription-detail-label">
                            Amount
                        </span>

                        <strong>
                            @Model.PlanPrice.ToString("0.00") EGP
                        </strong>

                    </div>

                </div>

                <div class="alert alert-iron-warning mt-4 mb-4"
                     role="note">

                    <strong>Payment confirmation:</strong>

                    Confirming this payment will activate your
                    subscription immediately.

                </div>

                <form asp-controller="Payments"
                      asp-action="CreatePayment"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="subscriptionId"
                           value="@Model.Subscription.Id" />

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-end
                                gap-2">

                        <a asp-controller="Plans"
                           asp-action="Index"
                           class="btn btn-iron-outline">

                            Back to plans

                        </a>

                        <button type="submit"
                                class="btn btn-iron">

                            Confirm payment

                        </button>

                    </div>

                </form>

            </div>

        </div>
    </div>

</section>