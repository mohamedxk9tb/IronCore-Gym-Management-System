@model GymMvc.ViewModels.MemberDashboardViewModel

@{
    ViewData["Title"] = "Member dashboard";
    ViewData["Section"] = "Member";
    ViewData["Dashboard"] = true;
}

<header class="page-header">

    <div>

        <p class="section-kicker">
            Member area / Performance plan
        </p>

        <h1>
            Welcome, @Model.FullName.
        </h1>

        <p>
            Your personal training overview and latest progress.
        </p>

    </div>

    <a class="btn btn-iron"
       asp-controller="Member"
       asp-action="CheckIn">

        Check in

    </a>

</header>


<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>
                Current weight
            </span>

            <strong>
                @Model.CurrentWeight.ToString("0.0")
            </strong>

            <p>
                kg
            </p>

        </article>

    </div>


    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>
                Height
            </span>

            <strong>
                @Model.Height.ToString("0.0")
            </strong>

            <p>
                cm
            </p>

        </article>

    </div>


    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>
                Monthly check-ins
            </span>

            <strong>
                @Model.MonthlyCheckIns
            </strong>

            <p>
                This month
            </p>

        </article>

    </div>


    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>
                Weight records
            </span>

            <strong>
                @Model.TotalWeightLogs
            </strong>

            <p>
                Total progress logs
            </p>

        </article>

    </div>

</div>


<div class="row g-4">

    <div class="col-lg-7">

        <section class="content-panel h-100">

            <p class="section-kicker">
                Your goal
            </p>

            <h2 class="panel-title">
                @(
                    string.IsNullOrWhiteSpace(Model.Goal)
                        ? "No goal set yet"
                        : Model.Goal
                )
            </h2>

            <p class="text-secondary">
                Keep your profile updated so your training
                information stays accurate.
            </p>

            <div class="d-flex flex-wrap gap-2 mt-4">

                <a class="btn btn-iron"
                   asp-controller="Member"
                   asp-action="Profile">

                    Update profile

                </a>

                <a class="btn btn-iron-outline"
                   asp-controller="Member"
                   asp-action="Progress">

                    View progress

                </a>

            </div>

        </section>

    </div>


    <div class="col-lg-5">

        <section class="content-panel h-100">

            <h2 class="panel-title">
                Quick actions
            </h2>

            <div class="quick-actions">

                <a asp-controller="Member"
                   asp-action="FitnessPlan">

                    Review fitness plan

                </a>

                <a asp-controller="Member"
                   asp-action="Progress">

                    Log progress snapshot

                </a>

                <a asp-controller="Member"
                   asp-action="Profile">

                    Update profile

                </a>

                <a asp-controller="Member"
                   asp-action="ChangePassword">

                    Change password

                </a>

            </div>

        </section>

    </div>


    <div class="col-lg-7">

        <section class="content-panel h-100">

            <h2 class="panel-title">
                Recent activity
            </h2>

            <div class="timeline">

                @if (Model.LastCheckIn.HasValue)
                {
                    <p>
                        <strong>
                            @Model.LastCheckIn.Value.ToString("dd MMM")
                        </strong>

                        — Latest check-in recorded.
                    </p>
                }

                @if (Model.LastWeightLog.HasValue)
                {
                    <p>
                        <strong>
                            @Model.LastWeightLog.Value.ToString("dd MMM")
                        </strong>

                        — Weight check recorded:
                        @Model.CurrentWeight.ToString("0.0") kg.
                    </p>
                }

                @if (!Model.LastCheckIn.HasValue &&
                     !Model.LastWeightLog.HasValue)
                {
                    <p class="text-secondary mb-0">
                        No activity recorded yet.
                    </p>
                }

            </div>

        </section>

    </div>


    <div class="col-lg-5">

        <section class="content-panel h-100">

            <p class="section-kicker">
                Progress snapshot
            </p>

            <h2 class="panel-title">

                @Model.CurrentWeight.ToString("0.0") kg

            </h2>

            @if (Model.WeightChange.HasValue)
            {
                var change = Model.WeightChange.Value;

                <p class="text-secondary">

                    @(change > 0 ? "+" : "")
                    @change.ToString("0.0") kg
                    since your previous weight record.

                </p>
            }
            else
            {
                <p class="text-secondary">

                    Add more weight records to track
                    your progress over time.

                </p>
            }

        </section>

    </div>


    <div class="col-12">

        <section class="content-panel">

            <p class="section-kicker">
                Membership & classes
            </p>

            <h2 class="panel-title">
                Coming with the team integration
            </h2>

            <p class="text-secondary mb-0">
                Membership status, subscription expiry,
                upcoming classes and bookings will appear here
                after the Membership, Classes and Booking models
                are integrated.
            </p>

        </section>

    </div>

</div>