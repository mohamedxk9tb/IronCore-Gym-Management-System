@model GymMvc.ViewModels.MemberProgressViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "My Progress";
    ViewData["Dashboard"] = true;

    var chartLabels = Model.WeightHistory
        .Select(item => item.Date.ToString("dd MMM"))
        .ToList();

    var chartValues = Model.WeightHistory
        .Select(item => item.Weight)
        .ToList();
}

<partial name="_PageHeader"
         model='new Dictionary<string, string>
         {
             ["Title"] = "My progress",
             ["Description"] = "Track your weight history and training progress.",
             ["Eyebrow"] = "Member area"
         }' />

<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>Current weight</span>

            <strong>
                @Model.CurrentWeight.ToString("0.0")
            </strong>

            <p>kg today</p>

        </article>

    </div>

    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>Starting weight</span>

            <strong>
                @Model.StartingWeight.ToString("0.0")
            </strong>

            <p>
                @(
                    Model.StartingDate.HasValue
                        ? Model.StartingDate.Value.ToString("dd MMM yyyy")
                        : "Current profile weight"
                )
            </p>

        </article>

    </div>

    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>Weight records</span>

            <strong>
                @Model.TotalRecords
            </strong>

            <p>Recorded measurements</p>

        </article>

    </div>

    <div class="col-sm-6 col-xl-3">

        <article class="stat-card">

            <span>Overall change</span>

            <strong>
                @(
                    Model.TotalChange.HasValue
                        ? $"{(Model.TotalChange.Value > 0 ? "+" : "")}{Model.TotalChange.Value:0.0}"
                        : "—"
                )
            </strong>

            <p>kg since first record</p>

        </article>

    </div>

</div>


<div class="row g-4">

    <div class="col-lg-8">

        <section class="content-panel h-100">

            <div class="d-flex justify-content-between align-items-start gap-3">

                <div>

                    <p class="section-kicker">
                        Weight history
                    </p>

                    <h2 class="panel-title">
                        Measured progress
                    </h2>

                </div>

                @if (Model.TotalChange.HasValue)
                {
                    <span class="status-pill">

                        @(Model.TotalChange.Value > 0 ? "+" : "")
                        @Model.TotalChange.Value.ToString("0.0") kg

                    </span>
                }

            </div>

            @if (Model.WeightHistory.Any())
            {
                <div class="progress-chart">

                    <canvas id="weightProgressChart"
                            aria-label="Weight progress history"
                            role="img">
                    </canvas>

                </div>
            }
            else
            {
                <div class="empty-state py-5">

                    <h3>
                        No weight records yet.
                    </h3>

                    <p class="text-secondary mb-0">
                        Add your first weight measurement to start
                        tracking your progress.
                    </p>

                </div>
            }

        </section>

    </div>


    <div class="col-lg-4">

        <section class="content-panel h-100">

            <p class="section-kicker">
                Log progress
            </p>

            <h2 class="panel-title">
                Add a measurement
            </h2>

            <p class="text-secondary">
                Record your current weight to keep your progress
                history up to date.
            </p>

            <form asp-controller="Member"
                  asp-action="LogWeight"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="mb-3">

                    <label asp-for="NewWeight"
                           class="form-label">
                    </label>

                    <input asp-for="NewWeight"
                           class="form-control"
                           type="number"
                           step="0.1"
                           min="0.1"
                           max="500" />

                    <span asp-validation-for="NewWeight"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="NewWeightDate"
                           class="form-label">
                    </label>

                    <input asp-for="NewWeightDate"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="NewWeightDate"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-iron w-100">

                    Save measurement

                </button>

            </form>

        </section>

    </div>


    <div class="col-12">

        <section class="content-panel">

            <p class="section-kicker">
                Training data
            </p>

            <h2 class="panel-title">
                Progress tracking
            </h2>

            <p class="text-secondary mb-0">
                Additional measurements and coaching metrics can
                be added when their corresponding models are
                integrated into the final project.
            </p>

        </section>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    @if (Model.WeightHistory.Any())
    {
        <script src="~/lib/chart.js/chart.umd.min.js"></script>

        <script>
            const weightLabels =
                @Html.Raw(JsonSerializer.Serialize(chartLabels));

            const weightValues =
                @Html.Raw(JsonSerializer.Serialize(chartValues));

            const weightChart =
                document.getElementById("weightProgressChart");

            if (weightChart) {
                new Chart(weightChart, {
                    type: "line",

                    data: {
                        labels: weightLabels,

                        datasets: [
                            {
                                label: "Weight (kg)",
                                data: weightValues,
                                tension: 0.3,
                                fill: false
                            }
                        ]
                    },

                    options: {
                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                display: false
                            }
                        },

                        scales: {
                            y: {
                                beginAtZero: false
                            }
                        }
                    }
                });
            }
        </script>
    }
}