@{
    ViewData["Title"] = "AI Coach";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "AI coach",
    ["Description"] = "Ask about training, exercise technique, and general fitness.",
    ["Eyebrow"] = "Member area"
})

<section class="content-panel">

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-start
                gap-3 mb-4">

        <div>

            <p class="section-kicker mb-1">
                Coach assistant
            </p>

            <h2 class="panel-title mb-2">
                Ask your fitness question.
            </h2>

            <p class="text-secondary mb-0">
                Get general guidance about training and fitness.
            </p>

        </div>

        <button type="button"
                class="btn btn-iron-outline"
                id="clearChatButton">
            Clear chat
        </button>

    </div>


    @Html.AntiForgeryToken()


    <div class="alert alert-iron-warning mb-4"
         role="note">

        <strong>General information only.</strong>

        This assistant provides general fitness information
        and is not a substitute for medical advice or a
        qualified trainer.

    </div>


    <div class="ai-chat-shell">

        <div id="chatMessages"
             class="ai-chat-messages"
             aria-live="polite"
             aria-label="AI coach conversation">

            <div class="ai-message ai-message-assistant">

                <div class="ai-message-label">
                    IRONCORE COACH
                </div>

                <div class="ai-message-body">
                    Hey. Ask me about your workout, exercise
                    technique, recovery, or general fitness.
                </div>

            </div>

        </div>


        <form id="chatForm"
              class="ai-chat-form">

            <label for="messageInput"
                   class="visually-hidden">
                Your fitness question
            </label>

            <div class="input-group">

                <textarea id="messageInput"
                          class="form-control"
                          rows="2"
                          maxlength="500"
                          placeholder="Ask your fitness question..."
                          required></textarea>

                <button type="submit"
                        class="btn btn-iron"
                        id="sendMessageButton">

                    <span id="sendMessageText">
                        Send
                    </span>

                    <span id="sendMessageLoading"
                          class="d-none">

                        <span class="spinner-border spinner-border-sm me-1"
                              aria-hidden="true"></span>

                        Thinking...

                    </span>

                </button>

            </div>

            <div class="d-flex justify-content-between
                        gap-3
                        mt-2">

                <small class="text-secondary">
                    Maximum 500 characters.
                </small>

                <small class="text-secondary"
                       id="characterCount">
                    0 / 500
                </small>

            </div>

        </form>

    </div>

</section>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("chatForm");

            const input =
                document.getElementById("messageInput");

            const messages =
                document.getElementById("chatMessages");

            const sendButton =
                document.getElementById("sendMessageButton");

            const sendText =
                document.getElementById("sendMessageText");

            const sendLoading =
                document.getElementById("sendMessageLoading");

            const clearButton =
                document.getElementById("clearChatButton");

            const characterCount =
                document.getElementById("characterCount");

            const tokenInput =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            if (!form || !input || !messages) {
                return;
            }


            function scrollToBottom() {

                messages.scrollTop =
                    messages.scrollHeight;

            }


            function addMessage(role, text) {

                const wrapper =
                    document.createElement("div");

                wrapper.className =
                    role === "user"
                        ? "ai-message ai-message-user"
                        : "ai-message ai-message-assistant";


                const label =
                    document.createElement("div");

                label.className =
                    "ai-message-label";

                label.textContent =
                    role === "user"
                        ? "YOU"
                        : "IRONCORE COACH";


                const body =
                    document.createElement("div");

                body.className =
                    "ai-message-body";

                body.textContent =
                    text;


                wrapper.appendChild(label);
                wrapper.appendChild(body);

                messages.appendChild(wrapper);

                scrollToBottom();
            }


            function setLoading(isLoading) {

                sendButton.disabled =
                    isLoading;

                if (isLoading) {

                    sendText.classList.add("d-none");

                    sendLoading.classList.remove("d-none");

                }
                else {

                    sendText.classList.remove("d-none");

                    sendLoading.classList.add("d-none");

                }

            }


            function updateCharacterCount() {

                characterCount.textContent =
                    `${input.value.length} / 500`;

            }


            input.addEventListener(
                "input",
                updateCharacterCount
            );


            input.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Enter" &&
                        !event.shiftKey
                    ) {

                        event.preventDefault();

                        form.requestSubmit();

                    }

                }
            );


            form.addEventListener(
                "submit",
                async function (event) {

                    event.preventDefault();

                    const message =
                        input.value.trim();

                    if (!message) {
                        return;
                    }

                    if (message.length > 500) {
                        return;
                    }

                    if (!tokenInput) {

                        addMessage(
                            "assistant",
                            "Unable to validate this request. Please refresh the page and try again."
                        );

                        return;
                    }


                    addMessage(
                        "user",
                        message
                    );

                    input.value = "";

                    updateCharacterCount();

                    setLoading(true);


                    try {

                        const response =
                            await fetch(
                                "/AiChat/SendMessage",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json",

                                        "RequestVerificationToken":
                                            tokenInput.value
                                    },

                                    body: JSON.stringify({
                                        message: message
                                    })
                                }
                            );


                        const data =
                            await response.json();


                        if (!response.ok) {

                            throw new Error(
                                data.error ||
                                "Unable to get a response."
                            );

                        }


                        addMessage(
                            "assistant",
                            data.reply ||
                            "I could not generate a response."
                        );

                    }
                    catch (error) {

                        addMessage(
                            "assistant",
                            error.message ||
                            "Something went wrong. Please try again."
                        );

                    }
                    finally {

                        setLoading(false);

                        input.focus();

                    }

                }
            );


            clearButton.addEventListener(
                "click",
                async function () {

                    if (!tokenInput) {
                        return;
                    }


                    clearButton.disabled =
                        true;


                    try {

                        const response =
                            await fetch(
                                "/AiChat/ClearChat",
                                {
                                    method: "POST",

                                    headers: {
                                        "RequestVerificationToken":
                                            tokenInput.value
                                    }
                                }
                            );


                        const data =
                            await response.json();


                        if (!response.ok) {

                            throw new Error(
                                data.error ||
                                "Unable to clear the chat."
                            );

                        }


                        messages.innerHTML = "";

                        addMessage(
                            "assistant",
                            "Chat cleared. What would you like to work on?"
                        );

                    }
                    catch (error) {

                        addMessage(
                            "assistant",
                            error.message ||
                            "Unable to clear the chat."
                        );

                    }
                    finally {

                        clearButton.disabled =
                            false;

                    }

                }
            );


            updateCharacterCount();

            scrollToBottom();

        });
    </script>
}