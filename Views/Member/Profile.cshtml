@model GymMvc.ViewModels.MemberProfileViewModel

@{
    ViewData["Title"] = "Profile";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Your profile",
    ["Description"] = "Manage your personal and fitness information.",
    ["Eyebrow"] = "Member"
})

<div class="content-panel">

    <div class="row g-4">

        <div class="col-lg-8">

            <form asp-controller="Member"
                  asp-action="Profile"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="FullName"
                               class="form-label">
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Height"
                               class="form-label">
                        </label>

                        <input asp-for="Height"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="300" />

                        <span asp-validation-for="Height"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Weight"
                               class="form-label">
                        </label>

                        <input asp-for="Weight"
                               class="form-control"
                               type="number"
                               step="0.1"
                               min="0"
                               max="500" />

                        <span asp-validation-for="Weight"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="FitnessLevel"
                               class="form-label">
                        </label>

                        <select asp-for="FitnessLevel"
                                class="form-select">

                            <option value="">
                                Select your fitness level
                            </option>

                            <option value="Beginner">
                                Beginner
                            </option>

                            <option value="Intermediate">
                                Intermediate
                            </option>

                            <option value="Advanced">
                                Advanced
                            </option>

                        </select>

                        <span asp-validation-for="FitnessLevel"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Goal"
                               class="form-label">
                        </label>

                        <textarea asp-for="Goal"
                                  class="form-control"
                                  rows="4"
                                  placeholder="What are you working toward?"></textarea>

                        <span asp-validation-for="Goal"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="d-flex justify-content-end mt-4">

                    <button type="submit"
                            class="btn btn-iron">

                        Save changes

                    </button>

                </div>

            </form>

        </div>

        <div class="col-lg-4">

            <div class="content-panel h-100">

                <p class="auth-kicker">
                    IRONCORE / Profile
                </p>

                <h3 class="mb-3">
                    Your training identity.
                </h3>

                <p class="text-secondary mb-0">
                    Keep your personal and fitness information
                    up to date so your training experience stays accurate.
                </p>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}