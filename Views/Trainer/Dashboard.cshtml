@model GymMvc.ViewModels.TrainerDashboardViewModel

@{
    ViewData["Title"] = "Trainer Dashboard";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = $"Welcome, {Model.TrainerName}",
    ["Description"] = "Today's classes, rosters, and attendance in one place.",
    ["Eyebrow"] = "Coach workspace"
})

<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-4">

        @await Html.PartialAsync(
            "_StatCard",
            new Dictionary<string, string>
            {
                ["Title"] = "Today's classes",
                ["Value"] = Model.Classes.Count.ToString(),
                ["Icon"] = "01"
            })

    </div>

    <div class="col-sm-6 col-xl-4">

        @await Html.PartialAsync(
            "_StatCard",
            new Dictionary<string, string>
            {
                ["Title"] = "Booked members",
                ["Value"] = Model.Classes
                    .Sum(c => c.Members.Count)
                    .ToString(),
                ["Icon"] = "02"
            })

    </div>

    <div class="col-sm-6 col-xl-4">

        @await Html.PartialAsync(
            "_StatCard",
            new Dictionary<string, string>
            {
                ["Title"] = "Attendance marked",
                ["Value"] = Model.Classes
                    .SelectMany(c => c.Members)
                    .Count(m => m.IsPresent)
                    .ToString(),
                ["Icon"] = "03"
            })

    </div>

</div>


<section class="content-panel">

    <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-end
                gap-3 mb-4">

        <div>

            <p class="section-kicker mb-1">
                Today's schedule
            </p>

            <h2 class="panel-title mb-1">
                Classes & attendance
            </h2>

            <p class="text-secondary mb-0">
                Review your booked members and mark attendance.
            </p>

        </div>

        <span class="status-pill">
            @DateTime.Now.ToString("dddd, dd MMM yyyy")
        </span>

    </div>


    @if (Model.Classes.Any())
    {
        <div class="row g-4">

            @foreach (var gymClass in Model.Classes)
            {
                <div class="col-12">

                    <article class="content-panel">

                        <div class="d-flex flex-column flex-md-row
                                    justify-content-between
                                    align-items-md-start
                                    gap-3 mb-4">

                            <div>

                                <p class="section-kicker mb-1">
                                    @gymClass.Time
                                </p>

                                <h3 class="h3 mb-0">
                                    @gymClass.ClassName
                                </h3>

                            </div>

                            <span class="status-pill">
                                @gymClass.Members.Count member@(gymClass.Members.Count == 1 ? "" : "s")
                            </span>

                        </div>


                        @if (gymClass.Members.Any())
                        {
                            <div class="table-responsive">

                                <table class="table table-dark
                                              table-hover
                                              align-middle
                                              mb-0">

                                    <thead>

                                        <tr>

                                            <th>
                                                Member
                                            </th>

                                            <th>
                                                Attendance
                                            </th>

                                            <th class="text-end">
                                                Action
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var member in gymClass.Members)
                                        {
                                            <tr>

                                                <td>

                                                    <div class="fw-semibold">
                                                        @member.MemberName
                                                    </div>

                                                    <small class="text-secondary">
                                                        Member #@member.MemberId
                                                    </small>

                                                </td>


                                                <td>

                                                    @if (member.IsPresent)
                                                    {
                                                        <span class="status-pill">
                                                            Present
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-secondary">
                                                            Not marked
                                                        </span>
                                                    }

                                                </td>


                                                <td class="text-end">

                                                    <form asp-controller="TrainerDashboard"
                                                          asp-action="MarkAttendance"
                                                          method="post"
                                                          class="d-inline-flex
                                                                 flex-wrap
                                                                 justify-content-end
                                                                 gap-2">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="bookingId"
                                                               value="@member.BookingId" />

                                                        <input type="hidden"
                                                               name="isPresent"
                                                               value="true" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-iron"
                                                                @(member.IsPresent ? "disabled" : null)>
                                                            Present
                                                        </button>

                                                    </form>


                                                    <form asp-controller="TrainerDashboard"
                                                          asp-action="MarkAttendance"
                                                          method="post"
                                                          class="d-inline-flex">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="bookingId"
                                                               value="@member.BookingId" />

                                                        <input type="hidden"
                                                               name="isPresent"
                                                               value="false" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-iron-outline"
                                                                @(!member.IsPresent ? "disabled" : null)>
                                                            Not present
                                                        </button>

                                                    </form>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            @await Html.PartialAsync(
                                "_EmptyState",
                                new Dictionary<string, string>
                                {
                                    ["Title"] = "No booked members",
                                    ["Message"] = "There are no members currently booked for this class."
                                })
                        }

                    </article>

                </div>
            }

        </div>
    }
    else
    {
        @await Html.PartialAsync(
            "_EmptyState",
            new Dictionary<string, string>
            {
                ["Title"] = "No classes today",
                ["Message"] = "You have no scheduled classes for today."
            })
    }

</section>