@{
    ViewData["Title"] = "Login";
    ViewData["AuthPage"] = true;
}

<main class="auth-stage" aria-labelledby="login-title">

    <header class="auth-stage-header">

        <a class="auth-back-link"
           asp-controller="Home"
           asp-action="Index">
            &larr; Back to Home
        </a>

        <a class="auth-logo"
           asp-controller="Home"
           asp-action="Index"
           aria-label="IRONCORE home">

            <img src="~/images/brand/ironcore-logo.svg"
                 alt="IRONCORE Gym and Fitness" />

        </a>

    </header>

    <section class="auth-editorial"
             aria-label="IRONCORE training message">

        <h1>
            Forge your<br />
            strongest<br />
            <span>self.</span>
        </h1>

        <p>
            Train harder. Move better. Become stronger.
        </p>

    </section>

    <section class="auth-card auth-card--login"
             data-auth-card>

        <section class="auth-form-panel"
                 aria-labelledby="login-title">

            <div class="auth-form-content">

                <p class="auth-kicker">
                    IRONCORE / Member access
                </p>

                <h2 id="login-title">
                    Login
                </h2>

                <p class="auth-form-intro">
                    Pick up where your stronger routine left off.
                </p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger auth-validation-summary"
                         role="alert">

                        <div asp-validation-summary="All"></div>

                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="auth-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewBag.ReturnUrl" />

                    <div class="auth-field">

                        <label for="Email">
                            Email
                        </label>

                        <input class="auth-input"
                               id="Email"
                               name="email"
                               type="email"
                               autocomplete="email"
                               placeholder="you@example.com"
                               required
                               aria-describedby="EmailError" />

                        <span class="auth-error"
                              id="EmailError"
                              aria-live="polite">
                        </span>

                    </div>

                    <div class="auth-field">

                        <label for="Password">
                            Password
                        </label>

                        <div class="auth-input-wrap">

                            <input class="auth-input auth-password-input"
                                   id="Password"
                                   name="password"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Enter your password"
                                   required
                                   aria-describedby="PasswordError" />

                            <button class="auth-visibility"
                                    type="button"
                                    data-password-toggle="Password"
                                    aria-label="Show password">
                                Show
                            </button>

                        </div>

                        <span class="auth-error"
                              id="PasswordError"
                              aria-live="polite">
                        </span>

                    </div>

                    <button class="btn btn-iron auth-submit"
                            type="submit">

                        Login

                    </button>

                </form>

                <p class="auth-switch">

                    Don't have an account?

                    <a asp-controller="Account"
                       asp-action="SignUp">
                        Sign up
                    </a>

                </p>

            </div>

        </section>

        @await Html.PartialAsync(
            "_AuthPandaPanel",
            new Dictionary<string, string>
            {
                ["Image"] = Url.Content("~/images/auth/panda-login.png"),
                ["Alt"] = "IRONCORE panda mascot for login"
            })

    </section>

</main>