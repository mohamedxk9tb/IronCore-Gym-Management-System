@{
    ViewData["Title"] = "Sign Up";
    ViewData["AuthPage"] = true;
}

<main class="auth-stage" aria-labelledby="signup-title">

    <header class="auth-stage-header">

        <a class="auth-back-link"
           asp-controller="Home"
           asp-action="Index">
            &larr; Back to Home
        </a>

        <a class="auth-logo"
           asp-controller="Home"
           asp-action="Index"
           aria-label="IRONCORE home">

            <img src="~/images/brand/ironcore-logo.svg"
                 alt="IRONCORE Gym and Fitness" />

        </a>

    </header>

    <section class="auth-editorial"
             aria-label="IRONCORE training message">

        <h1>
            Forge your<br />
            strongest<br />
            <span>self.</span>
        </h1>

        <p>
            Train harder. Move better. Become stronger.
        </p>

    </section>

    <section class="auth-card auth-card--signup"
             data-auth-card>

        @await Html.PartialAsync(
            "_AuthPandaPanel",
            new Dictionary<string, string>
            {
                ["Image"] = Url.Content("~/images/auth/panda-signup.png"),
                ["Alt"] = "IRONCORE panda mascot for sign up"
            })

        <section class="auth-form-panel"
                 aria-labelledby="signup-title">

            <div class="auth-form-content">

                <p class="auth-kicker">
                    IRONCORE / New member
                </p>

                <h2 id="signup-title">
                    Create account
                </h2>

                <p class="auth-form-intro">
                    Start with the basics. Build your profile next.
                </p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger auth-validation-summary"
                         role="alert">

                        <div asp-validation-summary="All"></div>

                    </div>
                }

                <form asp-controller="Account"
                      asp-action="SignUp"
                      method="post"
                      class="auth-form">

                    @Html.AntiForgeryToken()

                    <div class="auth-field">

                        <label for="FullName">
                            Full Name
                        </label>

                        <input class="auth-input"
                               id="FullName"
                               name="fullName"
                               type="text"
                               autocomplete="name"
                               placeholder="Your full name"
                               maxlength="100"
                               required />

                    </div>

                    <div class="auth-field">

                        <label for="Email">
                            Email
                        </label>

                        <input class="auth-input"
                               id="Email"
                               name="email"
                               type="email"
                               autocomplete="email"
                               placeholder="you@example.com"
                               maxlength="150"
                               required />

                    </div>

                    <div class="auth-field">

                        <label for="FitnessLevel">
                            Fitness Level
                        </label>

                        <select class="auth-input"
                                id="FitnessLevel"
                                name="fitnessLevel"
                                required>

                            <option value="">
                                Select your level
                            </option>

                            <option value="Beginner">
                                Beginner
                            </option>

                            <option value="Intermediate">
                                Intermediate
                            </option>

                            <option value="Advanced">
                                Advanced
                            </option>

                        </select>

                    </div>

                    <div class="auth-field">

                        <label for="Password">
                            Password
                        </label>

                        <div class="auth-input-wrap">

                            <input class="auth-input auth-password-input"
                                   id="Password"
                                   name="password"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Create a password"
                                   minlength="6"
                                   required />

                            <button class="auth-visibility"
                                    type="button"
                                    data-password-toggle="Password"
                                    aria-label="Show password">
                                Show
                            </button>

                        </div>

                        <div class="auth-strength"
                             data-password-strength>

                            <div class="auth-strength-track"
                                 aria-hidden="true">

                                <span></span>
                                <span></span>
                                <span></span>

                            </div>

                            <span class="auth-strength-label">
                                Use 6+ characters with a mix of letters and numbers
                            </span>

                        </div>

                    </div>

                    <div class="auth-field">

                        <label for="ConfirmPassword">
                            Confirm Password
                        </label>

                        <div class="auth-input-wrap">

                            <input class="auth-input auth-password-input"
                                   id="ConfirmPassword"
                                   name="confirmPassword"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Re-enter your password"
                                   required />

                            <button class="auth-visibility"
                                    type="button"
                                    data-password-toggle="ConfirmPassword"
                                    aria-label="Show confirm password">
                                Show
                            </button>

                        </div>

                    </div>

                    <button class="btn btn-iron auth-submit"
                            type="submit">

                        Create account

                    </button>

                </form>

                <p class="auth-switch">

                    Already have an account?

                    <a asp-controller="Account"
                       asp-action="Login">
                        Login
                    </a>

                </p>

            </div>

        </section>

    </section>

</main>