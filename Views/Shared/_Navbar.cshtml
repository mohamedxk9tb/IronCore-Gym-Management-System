@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? string.Empty;

    bool IsActive(
        string targetController,
        string targetAction = "")
        => controller == targetController &&
           (string.IsNullOrEmpty(targetAction) || action == targetAction);
}

<header class="site-header">

    <nav class="navbar navbar-expand-lg navbar-dark"
         aria-label="Primary navigation">

        <div class="container-xxl">

            <a class="brand brand-with-logo"
               asp-controller="Home"
               asp-action="Index"
               aria-label="IRONCORE home">

                <img src="~/images/brand/ironcore-logo.svg"
                     alt="IRONCORE Gym and Fitness" />

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#primaryNav"
                    aria-controls="primaryNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse"
                 id="primaryNav">

                <ul class="navbar-nav mx-lg-auto">

                    @if (!isAuthenticated)
                    {
                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Home") ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Plans") ? "active" : "")"
                               asp-controller="Plans"
                               asp-action="Index">

                                Plans

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Classes") ? "active" : "")"
                               asp-controller="Classes"
                               asp-action="Index">

                                Classes

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Trainers") ? "active" : "")"
                               asp-controller="Trainers"
                               asp-action="Index">

                                Trainers

                            </a>

                        </li>
                    }
                    else if (User.IsInRole("Member"))
                    {
                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Member", "Dashboard") ? "active" : "")"
                               asp-controller="Member"
                               asp-action="Dashboard">

                                Dashboard

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Member", "Profile") ? "active" : "")"
                               asp-controller="Member"
                               asp-action="Profile">

                                Profile

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Member", "Progress") ? "active" : "")"
                               asp-controller="Member"
                               asp-action="Progress">

                                Progress

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Member", "CheckIn") ? "active" : "")"
                               asp-controller="Member"
                               asp-action="CheckIn">

                                Check-in

                            </a>

                        </li>
                    }
                    else if (User.IsInRole("Trainer"))
                    {
                        <li class="nav-item">

                            <a class="nav-link @(IsActive("TrainerDashboard", "Dashboard") ? "active" : "")"
                               asp-controller="TrainerDashboard"
                               asp-action="Dashboard">

                                Dashboard

                            </a>

                        </li>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Dashboard") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Dashboard">

                                Dashboard

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Plans") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Plans">

                                Plans

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Classes") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Classes">

                                Classes

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Trainers") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Trainers">

                                Trainers

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Members") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Members">

                                Members

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Subscriptions") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Subscriptions">

                                Subscriptions

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Payments") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Payments">

                                Payments

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(IsActive("Admin", "Reports") ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Reports">

                                Reports

                            </a>

                        </li>
                    }

                </ul>


                <div class="nav-actions">

                    @if (!isAuthenticated)
                    {
                        <a class="nav-link @(IsActive("Account", "Login") ? "active" : "")"
                           asp-controller="Account"
                           asp-action="Login">

                            Log in

                        </a>


                        <a class="nav-link @(IsActive("Account", "SignUp") ? "active" : "")"
                           asp-controller="Account"
                           asp-action="SignUp">

                            Sign up

                        </a>


                        <a class="btn btn-iron btn-sm"
                           asp-controller="Plans"
                           asp-action="Index">

                            Join now

                        </a>
                    }
                    else
                    {
                        <span class="nav-user small text-secondary me-2">
                            @userName
                        </span>


                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline-flex align-items-center m-0">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="nav-link btn btn-link p-0">

                                Log out

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </nav>

</header>