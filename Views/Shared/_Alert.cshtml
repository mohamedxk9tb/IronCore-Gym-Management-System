@*
    Reads the TempData keys used by the controllers.

    AdminController / MemberController use:
    - SuccessMessage
    - ErrorMessage

    Warning and Info are kept for future controller use.
*@

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-iron-success alert-dismissible fade show"
         role="alert">

        <strong>Success.</strong> @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-iron-error alert-dismissible fade show"
         role="alert">

        <strong>Action needed.</strong> @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

@if (TempData["Warning"] is string warning)
{
    <div class="alert alert-iron-warning alert-dismissible fade show"
         role="alert">

        <strong>Please note.</strong> @warning

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

@if (TempData["Info"] is string info)
{
    <div class="alert alert-iron-info alert-dismissible fade show"
         role="alert">

        <strong>Update.</strong> @info

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}