@if (TempData["Error"] is string error)
{ <div class="alert alert-iron-error alert-dismissible" role="alert"><strong>Action needed.</strong> @error <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
@if (TempData["Warning"] is string warning)
{ <div class="alert alert-iron-warning alert-dismissible" role="alert"><strong>Please note.</strong> @warning <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
@if (TempData["Info"] is string info)
{ <div class="alert alert-iron-info alert-dismissible" role="alert"><strong>Update.</strong> @info <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }