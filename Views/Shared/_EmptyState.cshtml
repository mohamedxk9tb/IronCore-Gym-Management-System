@model IDictionary<string, string>

@{
    var title = Model.TryGetValue("Title", out var titleValue)
        ? titleValue
        : "";

    var description = Model.TryGetValue("Description", out var descriptionValue)
        ? descriptionValue
        : Model.TryGetValue("Message", out var messageValue)
            ? messageValue
            : "";

    var action = Model.TryGetValue("Action", out var actionValue)
        ? actionValue
        : null;
}

<section class="empty-state">
    <div class="empty-state-mark">+</div>

    <h2>@title</h2>

    <p>@description</p>

    @if (!string.IsNullOrWhiteSpace(action))
    {
        <button class="btn btn-iron" type="button">
            @action
        </button>
    }
</section>