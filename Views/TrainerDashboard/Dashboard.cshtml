@model GymMvc.ViewModels.TrainerDashboardViewModel

@{
    ViewData["Title"] = "Trainer Dashboard";
    ViewData["Dashboard"] = true;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Trainer Dashboard",
    ["Description"] = $"Welcome back, {Model.TrainerName}. Manage your classes and member attendance.",
    ["Eyebrow"] = "Trainer Workspace"
})

<section class="content-panel trainer-dashboard-page">

    <div class="row g-4">

        <!-- Trainer Summary -->
        <div class="col-12">

            <div class="dashboard-welcome-card">

                <div>
                    <p class="section-kicker mb-2">
                        Trainer
                    </p>

                    <h2 class="panel-title mb-2">
                        @Model.TrainerName
                    </h2>

                    <p class="text-secondary mb-0">
                        Here is your schedule and today's member attendance.
                    </p>
                </div>

                <div class="dashboard-welcome-icon">
                    <span>TR</span>
                </div>

            </div>

        </div>


        <!-- Today's Classes -->
        <div class="col-12">

            <div class="content-panel">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <p class="section-kicker mb-1">
                            Schedule
                        </p>

                        <h3 class="panel-title mb-0">
                            Today's Classes
                        </h3>
                    </div>

                    <span class="dashboard-count">
                        @Model.Classes.Count
                        @(Model.Classes.Count == 1 ? "Class" : "Classes")
                    </span>

                </div>


                @if (!Model.Classes.Any())
                {
                    <div class="empty-state">

                        <div class="empty-state-icon">
                            +
                        </div>

                        <h4 class="mb-2">
                            No classes today
                        </h4>

                        <p class="text-secondary mb-0">
                            You don't have any scheduled classes for today.
                        </p>

                    </div>
                }
                else
                {
                    <div class="row g-4">

                        @foreach (var gymClass in Model.Classes)
                        {
                            <div class="col-12 col-xl-6">

                                <div class="trainer-class-card">

                                    <!-- Class Header -->
                                    <div class="trainer-class-header">

                                        <div>

                                            <p class="section-kicker mb-2">
                                                Class
                                            </p>

                                            <h4 class="trainer-class-title mb-2">
                                                @gymClass.ClassName
                                            </h4>

                                            <div class="trainer-class-time">
                                                <span class="trainer-class-time-label">
                                                    Time
                                                </span>

                                                <strong>
                                                    @gymClass.Time
                                                </strong>
                                            </div>

                                        </div>

                                        <div class="trainer-class-icon">
                                            <span>01</span>
                                        </div>

                                    </div>


                                    <!-- Members -->
                                    <div class="trainer-members-section">

                                        <div class="d-flex justify-content-between align-items-center mb-3">

                                            <div>
                                                <p class="section-kicker mb-1">
                                                    Attendance
                                                </p>

                                                <h5 class="mb-0">
                                                    Members
                                                </h5>
                                            </div>

                                            <span class="dashboard-count">
                                                @gymClass.Members.Count
                                            </span>

                                        </div>


                                        @if (!gymClass.Members.Any())
                                        {
                                            <div class="trainer-empty-members">
                                                No members booked this class.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="trainer-members-list">

                                                @foreach (var member in gymClass.Members)
                                                {
                                                    <div class="trainer-member-row">

                                                        <div class="trainer-member-info">

                                                            <div class="trainer-member-avatar">
                                                                @member.MemberName.Substring(
                                                                    0,
                                                                    1
                                                                ).ToUpper()
                                                            </div>

                                                            <div>

                                                                <strong class="trainer-member-name">
                                                                    @member.MemberName
                                                                </strong>

                                                                <span class="trainer-member-status">
                                                                    @(member.IsPresent
                                                                        ? "Attendance recorded"
                                                                        : "Waiting for attendance")
                                                                </span>

                                                            </div>

                                                        </div>


                                                        @if (member.IsPresent)
                                                        {
                                                            <span class="attendance-badge attendance-present">
                                                                Present
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <form asp-action="MarkAttendance"
                                                                  method="post"
                                                                  class="m-0">

                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden"
                                                                       name="bookingId"
                                                                       value="@member.BookingId" />

                                                                <input type="hidden"
                                                                       name="isPresent"
                                                                       value="true" />

                                                                <button type="submit"
                                                                        class="btn btn-iron btn-sm">
                                                                    Mark Present
                                                                </button>

                                                            </form>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>

</section>