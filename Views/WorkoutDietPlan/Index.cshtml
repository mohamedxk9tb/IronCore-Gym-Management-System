@model GymMvc.ViewModels.WorkoutDietPlanDetailsViewModel

@{
    ViewData["Title"] = "Workout & Diet Plan";
}

<div class="container py-4">

    <h1>Workout & Diet Plan</h1>

    <p>
        Trainer:
        <strong>@Model.TrainerName</strong>
    </p>

    <p class="text-secondary">
        Created:
        @Model.CreatedDate.ToString("yyyy-MM-dd")
    </p>

    <hr />

    <div class="row g-4">

        <div class="col-md-6">

            <div class="card">
                <div class="card-body">

                    <h3>Workout Plan</h3>

                    @if (Model.Exercises.Count == 0)
                    {
                        <p class="text-secondary mb-0">No exercises have been added.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var exercise in Model.Exercises)
                            {
                                <div class="list-group-item">
                                    <strong>@exercise.ExerciseName</strong>
                                    <div class="text-secondary">
                                        @exercise.Sets sets x @exercise.Reps reps
                                    </div>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>

        </div>


        <div class="col-md-6">

            <div class="card">
                <div class="card-body">

                    <h3>Diet Plan</h3>

                    @if (Model.DietMeals.Count == 0)
                    {
                        <p class="text-secondary mb-0">No diet meals have been added.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var meal in Model.DietMeals)
                            {
                                <div class="list-group-item">
                                    <strong>@meal.MealName</strong>
                                    <div class="text-secondary">@meal.DayOfWeek</div>
                                    @if (!string.IsNullOrWhiteSpace(meal.Description))
                                    {
                                        <p class="mb-0">@meal.Description</p>
                                    }
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>

        </div>

    </div>

    <hr class="my-4" />

</div>