@model GymMvc.Models.Trainer

@{
    ViewData["Title"] = "Delete Trainer";
}

<section class="admin-trainer-delete-page">

    <div class="admin-form-header">

        <div>
            <p class="admin-kicker">COACHING TEAM</p>

            <h1>REMOVE TRAINER</h1>

            <p>
                Review the profile before permanently removing it.
            </p>
        </div>

        <a asp-controller="AdminTrainers"
           asp-action="Index"
           class="iron-admin-secondary">
            BACK TO TRAINERS
        </a>

    </div>

    <div class="delete-card">

        <div class="delete-mark">
            !
        </div>

        <p class="admin-kicker">CONFIRM ACTION</p>

        <h2>REMOVE @Model.FullName?</h2>

        <p class="delete-message">
            This action will remove this trainer from the
            administrative directory.
        </p>

        <div class="delete-profile">

            <div class="trainer-avatar large">
                @Model.FullName.Substring(
                    0,
                    Math.Min(1, Model.FullName.Length)
                ).ToUpper()
            </div>

            <div>
                <strong>@Model.FullName</strong>

                <span>
                    @Model.Specialty
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.Certificates))
                {
                    <small>
                        @Model.Certificates
                    </small>
                }
                else
                {
                    <small>
                        No certifications listed
                    </small>
                }
            </div>

        </div>

        <form asp-controller="AdminTrainers"
              asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="iron-validation-summary">
            </div>

            <div class="delete-actions">

                <a asp-controller="AdminTrainers"
                   asp-action="Index"
                   class="iron-admin-secondary">
                    CANCEL
                </a>

                <button type="submit"
                        class="iron-delete-button">
                    DELETE TRAINER
                </button>

            </div>

        </form>

    </div>

</section>