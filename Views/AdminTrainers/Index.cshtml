@model List<GymMvc.Models.Trainer>

@{
    ViewData["Title"] = "Admin - Trainers";
}

<section class="admin-trainers-page">

    <div class="admin-trainers-header">
        <div>
            <p class="admin-kicker">COACHING TEAM</p>
            <h1>TRAINERS</h1>
            <p class="admin-page-description">
                Manage the coaches who lead the IRONCORE training floor.
            </p>
        </div>

        <a asp-controller="AdminTrainers"
           asp-action="Create"
           class="iron-admin-primary">
            ADD TRAINER
        </a>
    </div>

    <div class="admin-trainers-toolbar">
        <div>
            <span class="toolbar-label">TRAINER DIRECTORY</span>
            <strong>@Model.Count TRAINER@(Model.Count == 1 ? "" : "S")</strong>
        </div>

        <span class="toolbar-status">
            @(Model.Any() ? "ACTIVE DIRECTORY" : "NO TRAINERS")
        </span>
    </div>

    @if (Model.Any())
    {
        <div class="admin-table-shell">

            <div class="admin-table-scroll">

                <table class="iron-admin-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>TRAINER</th>
                            <th>SPECIALTY</th>
                            <th>CERTIFICATIONS</th>
                            <th class="actions-column">ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var trainer in Model)
                        {
                            <tr>
                                <td class="trainer-id">
                                    #@trainer.Id
                                </td>

                                <td>
                                    <div class="trainer-name-cell">
                                        <div class="trainer-avatar">
                                            @trainer.FullName.Substring(
                                                0,
                                                Math.Min(1, trainer.FullName.Length)
                                            ).ToUpper()
                                        </div>

                                        <div>
                                            <strong>@trainer.FullName</strong>
                                            <span>IRONCORE COACH</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="specialty-value">
                                        @trainer.Specialty
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(trainer.Certificates))
                                    {
                                        <span class="certificate-value">
                                            @trainer.Certificates
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="not-listed">
                                            NOT LISTED
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="trainer-actions">

                                        <a asp-controller="AdminTrainers"
                                           asp-action="Edit"
                                           asp-route-id="@trainer.Id"
                                           class="trainer-action edit">
                                            EDIT
                                        </a>

                                        <a asp-controller="AdminTrainers"
                                           asp-action="Delete"
                                           asp-route-id="@trainer.Id"
                                           class="trainer-action delete">
                                            DELETE
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }
    else
    {
        <div class="admin-trainers-empty">

            <div class="empty-mark">+</div>

            <p class="admin-kicker">COACHING TEAM</p>

            <h2>NO TRAINERS YET</h2>

            <p>
                Add your first coach to start building the IRONCORE
                training team.
            </p>

            <a asp-controller="AdminTrainers"
               asp-action="Create"
               class="iron-admin-primary">
                ADD FIRST TRAINER
            </a>

        </div>
    }

</section>