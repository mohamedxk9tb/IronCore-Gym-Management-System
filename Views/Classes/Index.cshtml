@model GymMvc.ViewModels.ClassListViewModel

@{
    ViewData["Title"] = "Classes";
    ViewData["Dashboard"] = false;
}

@await Html.PartialAsync("_PageHeader", new Dictionary<string, string>
{
    ["Title"] = "Classes",
    ["Description"] = "Explore the weekly schedule and find your next session.",
    ["Eyebrow"] = "IRONCORE"
})

<section class="content-panel">

    <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-end
                gap-3 mb-4">

        <div>
            <p class="section-kicker mb-1">
                Weekly schedule
            </p>

            <h2 class="panel-title mb-1">
                Find your session.
            </h2>

            <p class="text-secondary mb-0">
                Search classes, filter by day, and check availability.
            </p>
        </div>

    </div>

    <form asp-controller="Classes"
          asp-action="Index"
          method="get"
          class="row g-3 mb-5">

        <div class="col-lg-5">

            <label for="search"
                   class="form-label">
                Search
            </label>

            <input id="search"
                   name="search"
                   value="@Model.CurrentSearch"
                   class="form-control"
                   type="search"
                   placeholder="Search classes..." />

        </div>

        <div class="col-md-4 col-lg-3">

            <label for="day"
                   class="form-label">
                Day
            </label>

            <select id="day"
                    name="day"
                    class="form-select">

                <option value="">
                    All days
                </option>

                @foreach (var day in new[]
                {
                    "Saturday",
                    "Sunday",
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday",
                    "Friday"
                })
                {
                    <option value="@day"
                            selected="@(Model.CurrentDay == day)">
                        @day
                    </option>
                }

            </select>

        </div>

        <div class="col-md-4 col-lg-2">

            <label for="sort"
                   class="form-label">
                Sort
            </label>

            <select id="sort"
                    name="sort"
                    class="form-select">

                <option value=""
                        selected="@string.IsNullOrEmpty(Model.CurrentSort)">
                    Schedule
                </option>

                <option value="name"
                        selected="@(Model.CurrentSort == "name")">
                    Name A–Z
                </option>

                <option value="name_desc"
                        selected="@(Model.CurrentSort == "name_desc")">
                    Name Z–A
                </option>

                <option value="time_desc"
                        selected="@(Model.CurrentSort == "time_desc")">
                    Latest time
                </option>

            </select>

        </div>

        <div class="col-md-4 col-lg-2 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-iron w-100">
                Apply
            </button>

        </div>

    </form>

    @if (Model.Classes.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model.Classes)
            {
                var gymClass = item.GymClass;

                <div class="col-md-6 col-xl-4">

                    <article class="content-panel h-100 d-flex flex-column">

                        <div class="d-flex justify-content-between
                                    align-items-start
                                    gap-3 mb-3">

                            <div>

                                <p class="section-kicker mb-1">
                                    @gymClass.DayOfWeek
                                </p>

                                <h3 class="h4 mb-1">
                                    @gymClass.Name
                                </h3>

                            </div>

                            @if (item.IsFull)
                            {
                                <span class="status-pill">
                                    Full
                                </span>
                            }
                            else
                            {
                                <span class="status-pill">
                                    Available
                                </span>
                            }

                        </div>

                        <div class="mb-4">

                            <div class="d-flex justify-content-between
                                        gap-3 mb-2">

                                <span class="text-secondary">
                                    Trainer
                                </span>

                                <strong>
                                    @item.TrainerName
                                </strong>

                            </div>

                            <div class="d-flex justify-content-between
                                        gap-3 mb-2">

                                <span class="text-secondary">
                                    Start
                                </span>

                                <strong>
                                    @gymClass.StartTime.ToString(@"hh\:mm")
                                </strong>

                            </div>

                            <div class="d-flex justify-content-between
                                        gap-3 mb-2">

                                <span class="text-secondary">
                                    Duration
                                </span>

                                <strong>
                                    @gymClass.DurationMinutes min
                                </strong>

                            </div>

                            <div class="d-flex justify-content-between
                                        gap-3">

                                <span class="text-secondary">
                                    Availability
                                </span>

                                <strong>
                                    @item.AvailableSlots /
                                    @gymClass.Capacity
                                </strong>

                            </div>

                        </div>

                        <div class="mt-auto">

                            <a asp-controller="Classes"
                               asp-action="Details"
                               asp-route-id="@gymClass.Id"
                               class="btn btn-iron-outline w-100">
                                View class
                            </a>

                        </div>

                    </article>

                </div>
            }

        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5"
                 aria-label="Classes pagination">

                <ul class="pagination justify-content-center mb-0">

                    <li class="page-item
                        @(Model.CurrentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="Classes"
                           asp-action="Index"
                           asp-route-search="@Model.CurrentSearch"
                           asp-route-day="@Model.CurrentDay"
                           asp-route-sort="@Model.CurrentSort"
                           asp-route-page="@(Model.CurrentPage - 1)">

                            Previous

                        </a>

                    </li>

                    @for (var pageNumber = 1;
                          pageNumber <= Model.TotalPages;
                          pageNumber++)
                    {
                        <li class="page-item
                            @(pageNumber == Model.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               asp-controller="Classes"
                               asp-action="Index"
                               asp-route-search="@Model.CurrentSearch"
                               asp-route-day="@Model.CurrentDay"
                               asp-route-sort="@Model.CurrentSort"
                               asp-route-page="@pageNumber">

                                @pageNumber

                            </a>

                        </li>
                    }

                    <li class="page-item
                        @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="Classes"
                           asp-action="Index"
                           asp-route-search="@Model.CurrentSearch"
                           asp-route-day="@Model.CurrentDay"
                           asp-route-sort="@Model.CurrentSort"
                           asp-route-page="@(Model.CurrentPage + 1)">

                            Next

                        </a>

                    </li>

                </ul>

            </nav>
        }
    }
    else
    {
        @await Html.PartialAsync(
            "_EmptyState",
            new Dictionary<string, string>
            {
                ["Title"] = "No classes found",
                ["Message"] = "Try changing your search or day filter."
            })
    }

</section>